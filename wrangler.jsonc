{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "python-wiki",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "py.namgt.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
